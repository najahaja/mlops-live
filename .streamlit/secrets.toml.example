# Copy to .streamlit/secrets.toml (never commit the real file) or paste into
# Streamlit Community Cloud -> App settings -> Secrets.
#
# Optional: base URL of a separately hosted ML-Ops-Live FastAPI service. When set, the demo
# sends predictions to {MLOPS_API_URL}/predict (which logs them to that service's database)
# and falls back to the bundled model if the service is unreachable. Leave unset to use the
# bundled champion model only.
# MLOPS_API_URL = "https://your-fastapi-host.example.com"
